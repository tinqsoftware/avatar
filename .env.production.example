APP_NAME="Avatar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ica-demo.ia.tinq.pe

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avatar
DB_USERNAME=avatar
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ia.tinq.pe
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=150

# Se activa únicamente al publicar medios nuevos; nunca durante una llamada pública.
AVATAR_VOICEBOX_ENABLED=false
AVATAR_VOICEBOX_URL=
AVATAR_VOICEBOX_TOKEN=
AVATAR_VOICEBOX_HEALTH_TIMEOUT_SECONDS=5
AVATAR_VOICEBOX_TIMEOUT_SECONDS=30

# El token solo existe en el VPS y en Salad.
AVATAR_ROUTER_ENABLED=true
AVATAR_ROUTER_URL=
AVATAR_ROUTER_TOKEN=
AVATAR_ROUTER_TIMEOUT_SECONDS=5
AVATAR_PUBLIC_DOMAIN_SUFFIX=ia.tinq.pe
AVATAR_LOCAL_DEFAULT_SLUG=ica-demo
